{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "ignorePaths": [
    ".github/workflows/docker.yml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "DokuWiki release pinned in .env (also written by bin/dc_build.sh)",
      "managerFilePatterns": [
        "/^\\.env$/"
      ],
      "matchStrings": [
        "DOKUWIKI_TAG=(?<currentValue>\\d{4}-\\d{2}-\\d{2}[a-z]?)\\s"
      ],
      "depNameTemplate": "dokuwiki/dokuwiki",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "loose",
      "extractVersionTemplate": "^release-(?<version>\\d{4}-\\d{2}-\\d{2}[a-z]?)$"
    }
  ],
  "packageRules": [
    {
      "description": "DokuWiki core updates",
      "matchDepNames": [
        "dokuwiki/dokuwiki"
      ],
      "commitMessageTopic": "DokuWiki",
      "labels": [
        "dependencies",
        "dokuwiki"
      ]
    },
    {
      "description": "PHP base image: version changes (e.g. 8.5 -> 8.6) get a PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "php"
      ],
      "labels": [
        "dependencies",
        "php"
      ]
    },
    {
      "description": "PHP base image: automerge digest-only updates of the same tag (e.g. rebuilt 8.5-apache)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "php"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "DokuWiki: automerge hotfixes of the current release (2026-07-14b -> 2026-07-14c); new releases get a PR",
      "matchDepNames": [
        "dokuwiki/dokuwiki"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchNewValue": "/^\\d{4}-\\d{2}-\\d{2}[a-z]$/",
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
