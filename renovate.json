{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Berlin",
  "labels": [
    "dependencies"
  ],
  "enabledManagers": [
    "docker-compose",
    "github-actions"
  ],
  "ignorePaths": [
    ".github/workflows/docker.yml"
  ],
  "packageRules": [
    {
      "description": "Upstream DokuWiki image: date tags (2026-07-14c), no rc/stable/latest; new releases get a PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dokuwiki/dokuwiki"
      ],
      "versioning": "loose",
      "allowedVersions": "/^\\d{4}-\\d{2}-\\d{2}[a-z]?$/",
      "pinDigests": true,
      "commitMessageTopic": "DokuWiki image",
      "labels": [
        "dependencies",
        "dokuwiki"
      ]
    },
    {
      "description": "Automerge rebuilds of the same tag (upstream PHP/OS patches)",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dokuwiki/dokuwiki"
      ],
      "matchUpdateTypes": [
        "pin",
        "pinDigest",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Automerge DokuWiki hotfixes (2026-07-14b -> 2026-07-14c); new releases get a PR",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "dokuwiki/dokuwiki"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "matchNewValue": "/^\\d{4}-\\d{2}-\\d{2}[a-z]$/",
      "automerge": true,
      "automergeType": "branch"
    }
  ]
}
